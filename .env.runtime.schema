# Runtime variables (used during application execution)
# @plugin(@varlock/proton-pass-plugin@2.0.1)
# @initProtonPass()
# @defaultSensitive=false

# ---

# @optional @type=port
API_PORT=8000

# API base URL
# @public @type=url @optional=eq($APP_MODE, ci)
NUXT_API_URL=if(
    eq($APP_MODE, dev),
    http://localhost:${API_PORT},
)

# GitHub token for feedback feature
# @sensitive @required=$USE_FEEDBACK
NUXT_FEEDBACK_GITHUB_TOKEN=protonPass(pass://DCC-KI/FEEDBACK_DEV_GITHUB_TOKEN/TOKEN, allowMissing=true)

# Use dummy data (default: false)
# @type=string
DUMMY=false

# Logger level (default: debug)
# @optional @public @type=enum(trace, debug, info, warn, error, fatal)
NUXT_PUBLIC_LOGGER_LOG_LEVEL=if(eq($APP_MODE, dev), debug, info)

# Common-UI flows that AnonyMate does not use yet. Disabling them stops the
# health/status widgets from reporting a disruption for missing endpoints.
# @optional @public @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_CHANGELOG=true

# @optional @public @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_DISCLAIMER=true

# @optional @public @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_ONBOARDING=true

# @optional @public @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_SYSTEM_STATUS=true
